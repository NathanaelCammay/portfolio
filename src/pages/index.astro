---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav';
import SocialLinks from '../components/SocialLinks';
import ThemeToggle from '../components/ThemeToggle';
import ExperienceList from '../components/ExperienceList';
import ProjectList from '../components/ProjectList';
import { cvFileName, education, experience, profile, toolkit } from '../data/profile';
import { getProjects } from '../lib/projects';
import { url } from '../lib/url';

const projects = (await getProjects()).map((project) => ({
	href: url(`projects/${project.id}`),
	title: project.data.title,
	summary: project.data.summary,
	stack: project.data.stack,
	year: project.data.date.getFullYear(),
}));

// Only link the CV once the file has been added to public/.
const hasCv = fs.existsSync(path.join(process.cwd(), 'public', cvFileName));

// schema.org "Person": tells search engines who this site is about and which profiles are also him.
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.title,
	url: Astro.site?.href,
	sameAs: [profile.github, profile.linkedin],
	worksFor: { '@type': 'Organization', name: 'Hollard Insurance' },
	address: { '@type': 'PostalAddress', addressLocality: 'Johannesburg', addressCountry: 'ZA' },
};
---

<BaseLayout jsonLd={person}>
	<div class="shell">
		<header class="sidebar">
			<div>
				<h1><a href={url()}>{profile.name}</a></h1>
				<p class="role">{profile.title}</p>
				<p class="pitch">{profile.pitch}</p>
				<SectionNav client:idle />
			</div>
			<div class="sidebar-footer">
				<SocialLinks />
				<ThemeToggle client:idle />
			</div>
		</header>

		<main class="content">
			<section id="about" class="section" aria-labelledby="about-heading">
				<h2 id="about-heading" class="section-label">About</h2>
				<p>
					I'm a software developer with over four years of experience on enterprise insurance systems at{' '}
					<strong>Hollard Insurance</strong>, where I work on <strong>Purple Heron</strong>, its claims platform.
				</p>
				<p>
					My work runs across the stack: C#/.NET and JavaScript in the application, stored procedures and performance
					tuning in SQL Server, and the adaptors and integrations that move data reliably between internal and
					external systems. I work in a SAFe Agile team alongside business analysts and testers, and I'm at my best
					untangling complex technical problems.
				</p>
				<p>
					Tools I use most: <span class="toolkit">{toolkit.join(' · ')}</span>
				</p>
			</section>

			<section id="experience" class="section" aria-labelledby="experience-heading">
				<h2 id="experience-heading" class="section-label">Experience</h2>
				<ExperienceList roles={experience} />

				<h3 class="subheading">Education &amp; certifications</h3>
				<ul class="compact">
					{
						education.map((item) => (
							<li>
								<span class="entry-meta">{item.period}</span>
								<span class="title">{item.title}</span>
								<span class="place">{item.place}</span>
							</li>
						))
					}
				</ul>

				{
					hasCv && (
						<a class="cta link" href={url(cvFileName)} download>
							Download full CV (PDF)
							<span class="arrow" aria-hidden="true">
								↗
							</span>
						</a>
					)
				}
			</section>

			<section id="projects" class="section" aria-labelledby="projects-heading">
				<h2 id="projects-heading" class="section-label">Projects</h2>
				<ProjectList projects={projects} />
			</section>

			<section id="contact" class="section" aria-labelledby="contact-heading">
				<h2 id="contact-heading" class="section-label">Contact</h2>
				<p class="contact-lead">Whether it's a role, a project or a question, I'd like to hear from you.</p>
				<a class="contact-email link" href={`mailto:${profile.email}`}>{profile.email}</a>
				<p class="contact-more">
					Or find me on <a class="link" href={profile.linkedin}>LinkedIn</a> and{' '}
					<a class="link" href={profile.github}>GitHub</a>. Based in {profile.location}.
				</p>
			</section>

			<footer class="colophon">
				<p>
					Built with <a class="link" href="https://astro.build">Astro</a> and React, set in Geist, and deployed to GitHub
					Pages. <a class="link" href={url('projects/portfolio-site')}>How this site was built</a>.
				</p>
			</footer>
		</main>
	</div>
</BaseLayout>
