---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { url } from '../lib/url';

// schema.org "Person": tells search engines who this site is about and which profiles are also him.
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.title,
	url: Astro.site?.href,
	sameAs: [profile.github, profile.linkedin],
	worksFor: { '@type': 'Organization', name: 'Hollard Insurance' },
	address: { '@type': 'PostalAddress', addressLocality: 'Johannesburg', addressCountry: 'ZA' },
};
---

<BaseLayout jsonLd={person}>
	<p class="muted">{profile.title} · {profile.location}</p>
	<h1>Hi, I'm Nathanael.</h1>
	<p class="lead">
		I build and maintain enterprise insurance systems with C#/.NET, SQL Server and JavaScript. That includes
		claims functionality, database work, and the integrations that keep data flowing between platforms.
	</p>
	<p class="lead">
		For 4+ years I've been a software developer at Hollard Insurance, working on the Purple Heron claims platform
		in a SAFe Agile team.
	</p>
	<div class="actions">
		<a class="button primary" href={url('contact')}>Get in touch</a>
		<a class="button" href={url('projects')}>See my work</a>
		<a class="button" href={url('about')}>About me</a>
	</div>
</BaseLayout>
