---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" noindex>
	<p class="muted">404</p>
	<h1>Page not found</h1>
	<p class="lead">That page doesn't exist, or it has moved.</p>
	<div class="actions">
		<a class="button primary" href={url()}>Go to the home page</a>
		<a class="button" href={url('projects')}>See my projects</a>
	</div>
</BaseLayout>
